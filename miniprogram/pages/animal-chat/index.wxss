.chat-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; color: #1d1d1f; background: #ffffff; }
.chat-bar { display: flex; justify-content: flex-end; padding: 8rpx 32rpx 0; }
.chat-bar__action { color: #174b36; font-size: 26rpx; font-weight: 650; }
.session-alert { margin: 8rpx 28rpx 0; display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; color: #8f3527; background: #fff0ed; border-radius: 20rpx; font-size: 23rpx; line-height: 1.5; }
.session-alert__copy { flex: 1; }
.session-alert__action { color: #174b36; font-weight: 700; }
.thread { flex: 1; height: 0; padding: 12rpx 28rpx 24rpx; box-sizing: border-box; }
.welcome { margin-top: 12rpx; }
.welcome-title { padding: 28rpx 28rpx 8rpx; font-size: 34rpx; font-weight: 650; line-height: 1.4; }
.assistant-bubble { max-width: 86%; margin-top: 16rpx; padding: 22rpx 26rpx; color: #1d1d1f; background: #f5f5f7; border-radius: 24rpx; font-size: 28rpx; line-height: 1.55; word-break: break-word; }
.assistant-bubble--typing { color: #6e6e73; }
.suggest-block { margin-top: 28rpx; }
.suggest-label { margin-bottom: 16rpx; color: #174b36; font-size: 24rpx; font-weight: 650; }
.suggest-item { margin-top: 12rpx; padding: 24rpx 26rpx; background: #f0f4f1; border-radius: 24rpx; font-size: 28rpx; line-height: 1.45; }
.user-row { display: flex; justify-content: flex-end; }
.user-bubble { max-width: 86%; margin-top: 16rpx; padding: 22rpx 26rpx; color: #ffffff; background: #174b36; border-radius: 24rpx; font-size: 28rpx; line-height: 1.55; word-break: break-word; }
.local-note { margin-top: 16rpx; color: #6e6e73; font-size: 22rpx; text-align: center; }
.send-error { margin-top: 16rpx; color: #8f3527; font-size: 24rpx; }
.inline-action { margin-left: 16rpx; color: #174b36; font-weight: 650; }
.composer { padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: #f5f5f7; border-radius: 24rpx 24rpx 0 0; }
.composer-actions { display: flex; gap: 16rpx; }
.chip { margin: 0; padding: 0 28rpx; height: 64rpx; line-height: 64rpx; color: #174b36; background: #ffffff; border-radius: 999rpx; font-size: 24rpx; font-weight: 650; }
.chip::after { border: 0; }
.composer-row { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.composer-input { flex: 1; height: 80rpx; padding: 0 28rpx; background: #ffffff; border-radius: 999rpx; font-size: 28rpx; }
.composer-placeholder { color: #8e8e93; }
.send-button { width: 140rpx; height: 80rpx; margin: 0; padding: 0; color: #ffffff; background: #174b36; border-radius: 999rpx; font-size: 28rpx; font-weight: 650; line-height: 80rpx; }
.send-button::after { border: 0; }
.send-button[disabled] { color: #ffffff; background: #8e8e93; }
.history-mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(29, 29, 31, .28); }
.history-sheet { width: 100%; max-height: 70vh; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #ffffff; border-radius: 24rpx 24rpx 0 0; }
.history-head { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 650; }
.history-fresh { color: #174b36; font-size: 26rpx; }
.history-list { max-height: 52vh; margin-top: 12rpx; }
.history-item { padding: 24rpx 8rpx; border-bottom: 1rpx solid #eeeeef; }
.history-item__title { overflow: hidden; font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.history-item__time { margin-top: 8rpx; color: #6e6e73; font-size: 22rpx; }
.history-empty { padding: 40rpx 8rpx; color: #6e6e73; font-size: 26rpx; text-align: center; }
.history-empty--error { color: #8f3527; }
