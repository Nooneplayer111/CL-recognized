.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  padding-bottom: 100rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 80rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  color: #fff;
  margin-top: 20rpx;
}

.content {
  margin-top: 20rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.card-header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 统计卡片 */
.stats-grid {
  display: flex;
  padding: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #667eea;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 大象列表 */
.elephant-list {
  padding: 10rpx 30rpx 30rpx;
}

.elephant-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.elephant-item:last-child {
  border-bottom: none;
}

.elephant-color {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.elephant-info {
  flex: 1;
}

.elephant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.elephant-confidence {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.elephant-id {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 下载卡片 */
.download-content {
  padding: 30rpx;
}

.download-tip {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
  text-align: center;
}

.download-success {
  font-size: 30rpx;
  color: #16a34a;
  text-align: center;
  padding: 20rpx 0;
  background: #f0fdf4;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.download-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(22, 163, 74, 0.3);
}

.download-btn[disabled] {
  opacity: 0.7;
}

.back-btn-wrap {
  text-align: center;
}

.back-btn {
  width: 60%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
}

/* 按钮hover效果 */
.download-btn:active,
.back-btn:active {
  transform: scale(0.98);
}