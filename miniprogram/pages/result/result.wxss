.container {
  min-height: 100vh;
  background-color: #f0f4f8;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.image-section {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.result-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  padding: 40rpx 30rpx 20rpx;
}

.overlay-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.main-result {
  text-align: center;
  padding: 40rpx 30rpx;
}

.result-header {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.result-badge {
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  font-weight: 500;
}

.result-badge.high {
  background-color: #dcfce7;
  color: #16a34a;
}

.result-badge.medium {
  background-color: #fef3c7;
  color: #f59e0b;
}

.result-badge.low {
  background-color: #fee2e2;
  color: #dc2626;
}

.elephant-info {
  padding: 20rpx 0;
}

.elephant-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.elephant-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.elephant-confidence {
  font-size: 30rpx;
  color: #64748b;
}

.confidence-card {
  padding: 30rpx;
}

.confidence-bar-wrap {
  height: 32rpx;
  background-color: #e2e8f0;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.confidence-bar {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.8s ease;
}

.confidence-bar.high {
  background: linear-gradient(90deg, #16a34a, #22c55e);
}

.confidence-bar.medium {
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

.confidence-bar.low {
  background: linear-gradient(90deg, #dc2626, #ef4444);
}

.confidence-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #94a3b8;
}

.prob-card {
  padding: 30rpx;
}

.prob-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.prob-item:last-child {
  margin-bottom: 0;
}

.prob-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prob-bar-wrap {
  flex: 1;
  height: 24rpx;
  background-color: #f1f5f9;
  border-radius: 12rpx;
  overflow: hidden;
}

.prob-bar {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.prob-bar.high {
  background: linear-gradient(90deg, #16a34a, #22c55e);
}

.prob-bar.medium {
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

.prob-bar.low {
  background: linear-gradient(90deg, #94a3b8, #cbd5e1);
}

.prob-value {
  width: 80rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: right;
}

.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.btn {
  display: block;
  width: auto;
  margin: 0;
  padding: 28rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-secondary {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #fff;
  border-radius: 50rpx;
}

.btn-secondary:active {
  opacity: 0.85;
}