<view class="container">
  <!-- 头部图片 -->
  <view class="image-section">
    <image src="{{imagePath}}" mode="aspectFill" class="result-image" />
    <view class="image-overlay">
      <view class="overlay-text">识别完成</view>
    </view>
  </view>

  <!-- 主要结果 -->
  <view class="card main-result">
    <view class="result-header">
      <view class="result-badge {{confLevelClass}}">
        {{ confLevelText }}
      </view>
    </view>
    
    <view class="elephant-info">
      <view class="elephant-icon">🐘</view>
      <view class="elephant-name">{{ result.elephant_name }}</view>
      <view class="elephant-confidence">置信度: {{ result.confidence }}%</view>
    </view>
  </view>

  <!-- 置信度指示 -->
  <view class="card confidence-card">
    <view class="card-title">置信度评估</view>
    <view class="confidence-bar-wrap">
      <view class="confidence-bar {{confLevelClass}}" style="width: {{result.confidence}}%"></view>
    </view>
    <view class="confidence-labels">
      <text>0%</text>
      <text>50%</text>
      <text>100%</text>
    </view>
  </view>

  <!-- 概率分布 -->
  <view class="card prob-card">
    <view class="card-title">各类别概率分布</view>
    <view wx:for="{{ sortedProbs }}" wx:key="name" class="prob-item">
      <view class="prob-name">{{ item.name }}</view>
      <view class="prob-bar-wrap">
        <view class="prob-bar {{item.class}}" style="width: {{item.prob}}%"></view>
      </view>
      <view class="prob-value">{{ item.probText }}%</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <view class="btn btn-secondary" bindtap="goBack">
      ← 返回重新识别
    </view>
  </view>
</view>