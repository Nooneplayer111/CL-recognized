.hero {
  text-align: center;
  padding: 60rpx 40rpx 50rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  color: #fff;
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  opacity: 0.85;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.menu-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  gap: 24rpx;
}

.menu-card:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.menu-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  font-size: 48rpx;
}

.menu-info {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: #64748b;
}

.menu-arrow {
  font-size: 44rpx;
  color: #cbd5e1;
  font-weight: 300;
  flex-shrink: 0;
}

.footer {
  padding: 48rpx 20rpx 20rpx;
  text-align: center;
}

.footer-text {
  font-size: 26rpx;
  color: #94a3b8;
}
