.placeholder-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-top: 80rpx;
}

.placeholder-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.placeholder-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.placeholder-desc {
  font-size: 28rpx;
  color: #94a3b8;
}
